AUTOTRADE_DATA_DIR=data
AUTOTRADE_DB_FILE=autotrade.db
# Railway Postgres provides DATABASE_URL automatically. AUTOTRADE_DATABASE_URL
# can be used to override it. Leave both blank for local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database
# AUTOTRADE_DATABASE_URL=
AUTOTRADE_ADMIN_PASSWORD=AutoTrade123!
AUTOTRADE_SECRET_KEY=replace-with-a-long-random-secret
AUTOTRADE_DEFAULT_DEALER=south-florida-demo
AUTOTRADE_MARKET_REGION=south_florida

# Optional dealer-owned market import CSV.
# AUTOTRADE_MARKET_FEED_CSV=/absolute/path/to/market-feed.csv

# Optional licensed valuation feeds.
# AUTOTRADE_MANHEIM_API_BASE=https://licensed-provider.example.com
# AUTOTRADE_MANHEIM_API_KEY=
# AUTOTRADE_JD_POWER_API_BASE=https://licensed-provider.example.com
# AUTOTRADE_JD_POWER_API_KEY=
# AUTOTRADE_BLACK_BOOK_API_BASE=https://licensed-provider.example.com
# AUTOTRADE_BLACK_BOOK_API_KEY=
# AUTOTRADE_KBB_API_BASE=https://licensed-provider.example.com
# AUTOTRADE_KBB_API_KEY=

# Optional CRM and messaging integrations.
# AUTOTRADE_CRM_WEBHOOK_URL=
# AUTOTRADE_SMTP_HOST=
# AUTOTRADE_SMTP_PORT=587
# AUTOTRADE_SMTP_USERNAME=
# AUTOTRADE_SMTP_PASSWORD=
# AUTOTRADE_SMS_WEBHOOK_URL=
